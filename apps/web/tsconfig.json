{
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "incremental": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@api/*": ["../../apps/api/src/*"],
      "@phena/api": ["../../apps/api/src/index.ts"],
      "@phena/ui/*": ["../../packages/ui/src/*"],
      "@phena/config": ["../../packages/config/src/index.ts"],
      "@phena/schema": ["../../packages/schema/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": true
  },
  "exclude": ["node_modules"],
  "include": ["next-env.d.ts", "next.config.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"]
}
